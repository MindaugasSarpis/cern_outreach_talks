node_modules
__pycache__/

.DS_Store
.vscode

dist-portable/
dist/
*-venue.zip
**/public/videos/
# public/videos-hq is a symlink made by slidev-videos pull-hq/venue; dangling in CI it kills the build
**/public/videos-hq
.playwright-mcp/
**/videos/raw/

# Safety net: videos only belong in the managed dirs above.
# Keeps stray masters from landing at a talk root and bypassing LFS/releases.
*.mp4
*.mov
*.mkv
*.webm
*.m4v
*.avi
# claude code worktrees — separate checkouts, never committed (one per talk: pnpm talk new/open)
.claude/worktrees/
.claude/settings.local.json
# per talk, never committed: headless shots (pnpm talk shots), throwaway scripts, workflow state
talks/*/shots/
talks/*/.scratch/
talks/*/.wf/
